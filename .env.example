# Polymer Blog Bot - environment config
# Copy this file to .env and fill in the values. `make deploy` passes them to the stack.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-

# Sanity (project a6d1clb1): same values as wrk-marketing's web/.env.local
SANITY_STUDIO_API_DATASET=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_URL=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_CONTENT_CHANNEL=

# Google Sheets - the OAuth client + refresh token inflow-ats and polymer-engagement-pipeline
# already use for the internal sheets (same names).
GOOGLE_INTERNAL_SHEETS_CLIENT_ID=
GOOGLE_INTERNAL_SHEETS_CLIENT_SECRET=
GOOGLE_INTERNAL_SHEETS_REFRESH_TOKEN=

# Search Console - a refresh token (same client) granted the webmasters scope.
# Leave empty to skip Google indexing requests.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GSC_SITE_URL=https://www.polymer.co/

# IndexNow key, also hosted at https://www.polymer.co/<key>.txt
INDEXNOW_KEY=

# GitHub - the Lambda commits each run's output (<slug>-output/ and the calendar CSV)
# to this repo. A run on your machine writes into the checkout and never pushes.
# Fine-grained PAT scoped to this one repo: Contents read and write.
GITHUB_REPO=<owner>/polymer-content-engine
GITHUB_TOKEN=github_pat_...
